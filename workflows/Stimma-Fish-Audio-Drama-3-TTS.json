      "widgets_values": [
        "fish-audio-drama-3-tts",
        "Fish Audio Drama 3",
        "text-to-speech",
        "",
        "Generate expressive speech locally from text, with a voice created from the seed. Use voice cloning to keep a chosen voice across separate generations.",
        "Fish Audio",
        "Drama 3",
        "The prompt is the exact text to speak. Place cues such as [sighs], [laughs], or [whispers] where they should happen; parentheses are spoken aloud. Long text is split automatically. If a take becomes silent or skips words, retry with another seed or a different reference. The per-chunk generation limit can truncate slow or very long speech; it is not a target duration. Check that the full script was spoken."
      ]
    },
